# Usage local uniquement. Sur GitHub, ces valeurs vont dans Settings > Secrets and variables > Actions.

# API X, facturation à l'usage (developer.x.com)
X_BEARER_TOKEN=
# Jev, modèle de décision de TypeSafe (console.typesafe.ai)
TYPESAFE_API_KEY=
# Claude, pour le second codage et les jeux (console.anthropic.com)
ANTHROPIC_API_KEY=
# Si la clé n'est rattachée à aucun espace de travail Anthropic : identifiant de l'espace (wrkspc_…)
ANTHROPIC_WORKSPACE_ID=

# Facultatif
JEV_MODEL=jev-latest
CLAUDE_MODEL=claude-opus-5-5
# Dossier des données si le dépôt privé n'est pas cloné dans data/
# DATA_DIR=/chemin/vers/french-presidential-2027-data
