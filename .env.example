# Jeton Bearer de l'API X (developer.x.com > Projects & Apps > Keys and tokens)
# L'accès en lecture aux timelines nécessite au minimum le niveau Basic.
X_BEARER_TOKEN=

# Clé API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optionnel : modèle Claude utilisé pour la classification (défaut : claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5
