# Jeton Bearer de l'API X (developer.x.com > Projects & Apps > Keys and tokens)
# La lecture des timelines est facturée à l'usage (pay-per-use).
X_BEARER_TOKEN=

# Clé API TypeSafe (console.typesafe.ai) pour le modèle de décision Jev
TYPESAFE_API_KEY=
# Optionnel : version de Jev (défaut : jev-latest)
JEV_MODEL=jev-latest

# Clé API Anthropic (console.anthropic.com) pour l'analyse « System Two » (Claude)
ANTHROPIC_API_KEY=
# Optionnel : modèle Claude (défaut : claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5
